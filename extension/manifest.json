{
  "manifest_version": 3,
  "name": "Webwing",
  "version": "0.1.0",
  "description": "타임인아웃·비즈플레이·Flow에 로그인된 상태에서 연차·초과근무·정정·경비 결의를 사이드 패널에서 조회합니다.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "https://user.timeinout.kr/*",
    "https://api.flow.team/*",
    "https://www.bizplay.co.kr/*",
    "https://*.appplay.co.kr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "page/index.html"
  },
  "action": {
    "default_title": "Webwing 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "0.1.0 (2026-08-05f)"
}
