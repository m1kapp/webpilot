{
  "manifest_version": 3,
  "name": "Webwing",
  "version": "0.1.0",
  "key": "",
  "description": "타임인아웃·비즈플레이·Flow에 로그인된 상태에서 연차·초과근무·정정·경비 결의를 사이드 패널에서 조회하고, 법정의무교육 진도를 관제합니다.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "https://user.timeinout.kr/*",
    "https://api.flow.team/*",
    "https://www.bizplay.co.kr/*",
    "https://*.bizplay.co.kr/*",
    "https://*.appplay.co.kr/*",
    "*://ehrd.kgeduone.co.kr/*",
    "*://*.campus21.co.kr/*",
    "*://kgeduone.wisehrd.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.campus21.co.kr/cpclassroom/onlinestudy/*"
      ],
      "js": [
        "content/edu-player.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://kgeduone.wisehrd.com/data/content/*"
      ],
      "js": [
        "content/edu-wise.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "page/index.html"
  },
  "action": {
    "default_title": "Webwing 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "0.1.0 (2026-08-28a)"
}
